# Copy this file to .env and fill in what you need. Everything has a working default.

# --- Database ---
# Local: SQLite file (no setup needed). Tables are created automatically on start.
# Production: paste the Postgres URL from Neon exactly as given, e.g.
#   postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./copilot.db

# Where the frontend runs (comma-separated). Add your Vercel URL when deployed.
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# Must be long and random (32+ characters) when using Postgres, or the app refuses to start.
# Make one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# These emails get the admin role when they sign up (can see /api/admin/stats).
ADMIN_EMAILS=you@example.com

# --- Market data ---
# yfinance = real prices.  demo = fake prices that work offline.
PRICE_SOURCE=yfinance

# --- AI agent ---
# Main AI: gemini or groq.  offline = rule-based answers, no key needed.
# Set BOTH keys and the other one becomes the backup: it answers if the main one fails
# (busy, out of free quota, model retired...). Basic mode is used only if both fail.
LLM_PROVIDER=offline
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Model names change often. If you get "404 NOT_FOUND", check the model list in AI Studio.
GEMINI_MODEL=gemini-3.5-flash
# Free key: https://console.groq.com/keys   Models: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Alerts ---
# true = the app runs the alert job itself every weekday at 6:30 pm IST.
# On free hosting that sleeps, keep false and use the GitHub Actions workflow + CRON_SECRET instead.
ENABLE_SCHEDULER=false
# Secret for POST /api/cron/daily-alerts. Empty = that endpoint is turned off.
CRON_SECRET=
# Create a bot with @BotFather on Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=
DAILY_MOVE_THRESHOLD_PCT=5
DRAWDOWN_THRESHOLD_PCT=15
CONCENTRATION_THRESHOLD_PCT=25
